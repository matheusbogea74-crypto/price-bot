# Copy this file to `.env` and fill in the values you need.
# Nothing here is required to boot the app — every integration degrades
# gracefully (falls back or logs a warning) when its variables are unset,
# except WHATSAPP_MY_NUMBER, which is required for outbound alerts to have
# a destination.

# ---------------------------------------------------------------------------
# Mercado Livre — official affiliate API (OAuth)
# Create an app at https://developers.mercadolivre.com.br/devcenter/create-app
# Only needed if you use the official-API code paths in src/mercadolivre/;
# the production scraping path does not require these.
# ---------------------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://example.com/callback
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
# Account-level affiliate link parameters (see docs/ARCHITECTURE.md).
ML_MATT_WORD=
ML_MATT_TOOL=

# ---------------------------------------------------------------------------
# Affiliate links
# ---------------------------------------------------------------------------
AMAZON_AFFILIATE_TAG=

# ---------------------------------------------------------------------------
# Apify — headless-browser Actor used for stores that block datacenter IPs
# (see docs/ARCHITECTURE.md for why this exists). Get a token at
# https://console.apify.com/account/integrations
# ---------------------------------------------------------------------------
APIFY_API_TOKEN=
CASASBAHIA_APIFY_ACTOR_ID=

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
# Phone number (with country code, digits only) that receives alerts.
WHATSAPP_MY_NUMBER=
# Optional: send to a group instead of your own number once validated.
WHATSAPP_GROUP_ID=

# ---------------------------------------------------------------------------
# Optional link redirector (hides affiliate query params behind a short URL).
# See the companion redirector service referenced in docs/ARCHITECTURE.md.
# ---------------------------------------------------------------------------
REDIRECTOR_BASE_URL=
REDIRECTOR_SYNC_SECRET=

# ---------------------------------------------------------------------------
# Coupon channel forwarding
# ---------------------------------------------------------------------------
COUPON_LOGO_IMAGE_URL=

# ---------------------------------------------------------------------------
# Optional AI deal-quality filter (Google Gemini). If unset, every deal that
# clears the discount threshold is approved automatically.
# Get a free key at https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
