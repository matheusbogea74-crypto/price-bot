{
  "name": "price-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted price-tracking bot: detects real historical-low prices and genuine deals, filters them with an optional AI relevance gate, and delivers alerts over WhatsApp.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheusbogea74-crypto/price-bot.git"
  },
  "bugs": {
    "url": "https://github.com/matheusbogea74-crypto/price-bot/issues"
  },
  "homepage": "https://github.com/matheusbogea74-crypto/price-bot#readme",
  "keywords": [
    "price-tracker",
    "price-monitor",
    "whatsapp-bot",
    "web-scraping",
    "deal-alerts",
    "affiliate-marketing"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-syntax.mjs",
    "init-db": "node src/db/init.js",
    "add-product": "node src/products/addProduct.js",
    "import-products": "node src/products/importProducts.js",
    "list-products": "node src/products/listProducts.js",
    "ml-auth-url": "node src/mercadolivre/getAuthUrl.js",
    "ml-exchange-code": "node src/mercadolivre/exchangeCode.js",
    "ml-refresh-token": "node src/mercadolivre/refreshAccessToken.js",
    "ml-get-item": "node src/mercadolivre/getItem.js",
    "scrape-ml": "node src/scrapers/mercadolivre.js",
    "scrape-amazon": "node src/scrapers/amazon.js",
    "scrape-casasbahia": "node src/scrapers/casasbahia.js",
    "scrape-netshoes": "node src/scrapers/netshoes.js",
    "check-prices": "node src/priceCheck/checkAllProducts.js",
    "set-affiliate-link": "node src/products/setAffiliateLink.js",
    "preview-ad": "node src/ads/previewAd.js",
    "wa-test": "node src/whatsapp/sendTestMessage.js",
    "wa-list-groups": "node src/whatsapp/listGroups.js",
    "discover": "node src/discovery/runDiscovery.js",
    "start": "node src/index.js"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "apify-client": "^2.23.4",
    "dotenv": "^18.0.4",
    "node-cron": "^4.6.0",
    "patchright": "^1.61.1",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
